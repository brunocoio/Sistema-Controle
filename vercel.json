{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.php"
    },
    {
      "source": "/logout",
      "destination": "/logout.php"
    },
    {
      "source": "/admin/index",
      "destination": "/admin/index.php"
    },
    {
      "source": "/admin/atletas",
      "destination": "/admin/atletas.php"
    },
    {
      "source": "/admin/atletas-novo",
      "destination": "/admin/atletas.php?route=new"
    },
    {
      "source": "/admin/atletas-categorias",
      "destination": "/admin/atletas.php?route=categories"
    },
    {
      "source": "/admin/editar-:token",
      "destination": "/admin/atletas.php?route=edit&token=:token"
    },
    {
      "source": "^/admin/atleta-([1-9][0-9]{0,17})-editar$",
      "destination": "/admin/atletas.php?route=edit&id=$1"
    },
    {
      "source": "^/admin/atleta-([1-9][0-9]{0,17})-foto-v([a-f0-9]{32})\\.img$",
      "destination": "/admin/atletas.php?route=photo&id=$1&v=$2"
    },
    {
      "source": "^/admin/atleta-([1-9][0-9]{0,17})-foto-v([a-f0-9]{32})\\.jpg$",
      "destination": "/admin/atletas.php?route=photo&id=$1&v=$2"
    },
    {
      "source": "/admin/atleta-:id-foto",
      "destination": "/admin/atletas.php?route=photo&id=:id"
    },
    {
      "source": "/admin/atletas-filtros-:state",
      "destination": "/admin/atletas.php?state=:state"
    },
    {
      "source": "/admin/eventos-novo",
      "destination": "/admin/eventos-novo.php"
    },
    {
      "source": "^/admin/evento-([1-9][0-9]{0,17})-editar$",
      "destination": "/admin/eventos.php?route=edit&id=$1"
    },
    {
      "source": "/admin/eventos",
      "destination": "/admin/eventos.php"
    },
    {
      "source": "/eventos",
      "destination": "/eventos.php"
    }
  ]
}
