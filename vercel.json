{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.php"
    },
    {
      "source": "/logout",
      "destination": "/logout.php"
    },
    {
      "source": "/admin/index",
      "destination": "/admin/index.php"
    },
    {
      "source": "/admin/usuarios",
      "destination": "/admin/usuarios.php"
    },
    {
      "source": "/admin/meu-perfil",
      "destination": "/admin/meu-perfil.php"
    },
    {
      "source": "/admin/modulos",
      "destination": "/admin/modulos.php"
    },
    {
      "source": "/admin/ui-preferences",
      "destination": "/admin/ui-preferences.php"
    },
    {
      "source": "/admin/usuarios-novo",
      "destination": "/admin/usuarios.php?novo=1"
    },
    {
      "source": "/admin/usuario-editar-:token",
      "destination": "/admin/usuarios.php?user_token=:token"
    },
    {
      "source": "/admin/usuario-:id-editar",
      "destination": "/admin/usuarios.php?id=:id"
    },
    {
      "source": "^/admin/usuario-atleta-([1-9][0-9]*)-novo$",
      "destination": "/admin/usuarios.php?atleta_id=$1"
    },
    {
      "source": "/admin/usuario-atleta-:token",
      "destination": "/admin/usuarios.php?link_token=:token"
    },
    {
      "source": "/admin/atletas",
      "destination": "/admin/atletas.php"
    },
    {
      "source": "/admin/atletas-novo",
      "destination": "/admin/atletas.php?route=new"
    },
    {
      "source": "/admin/atletas-categorias",
      "destination": "/admin/atletas.php?route=categories"
    },
    {
      "source": "/admin/editar-:token",
      "destination": "/admin/atletas.php?route=edit&token=:token"
    },
    {
      "source": "^/admin/atleta-([1-9][0-9]{0,17})-editar$",
      "destination": "/admin/atletas.php?route=edit&id=$1"
    },
    {
      "source": "^/admin/atleta-([1-9][0-9]{0,17})-foto-v([a-f0-9]{32})$",
      "destination": "/admin/atletas.php?route=photo&id=$1&v=$2"
    },
    {
      "source": "^/admin/atleta-([1-9][0-9]{0,17})-foto-v([a-f0-9]{32})\\.img$",
      "destination": "/admin/atletas.php?route=photo&id=$1&v=$2"
    },
    {
      "source": "^/admin/atleta-([1-9][0-9]{0,17})-foto-v([a-f0-9]{32})\\.jpg$",
      "destination": "/admin/atletas.php?route=photo&id=$1&v=$2"
    },
    {
      "source": "/admin/foto-atleta-:token",
      "destination": "/admin/atletas.php?route=photo&photo_token=:token"
    },
    {
      "source": "/admin/atleta-:id-foto",
      "destination": "/admin/atletas.php?route=photo&id=:id"
    },
    {
      "source": "/admin/atletas-filtros-:state",
      "destination": "/admin/atletas.php?state=:state"
    },
    {
      "source": "/admin/eventos-novo",
      "destination": "/admin/eventos-novo.php"
    },
    {
      "source": "/admin/evento-editar-:token",
      "destination": "/admin/eventos.php?event_token=:token"
    },
    {
      "source": "^/admin/evento-([1-9][0-9]{0,17})-editar$",
      "destination": "/admin/eventos.php?route=edit&id=$1"
    },
    {
      "source": "/admin/eventos",
      "destination": "/admin/eventos.php"
    },
    {
      "source": "/evento-imagem-:id",
      "destination": "/eventos.php?image=:id"
    },
    {
      "source": "/eventos",
      "destination": "/eventos.php"
    }
  ]
}
