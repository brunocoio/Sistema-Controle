{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin/atletas-novo",
      "destination": "/admin/atletas?route=new"
    },
    {
      "source": "/admin/atletas-categorias",
      "destination": "/admin/atletas?route=categories"
    },
    {
      "source": "^/admin/atleta-([1-9][0-9]{0,17})-editar$",
      "destination": "/admin/atletas?route=edit&id=$1"
    },
    {
      "source": "^/admin/atleta-([1-9][0-9]{0,17})-foto$",
      "destination": "/admin/atletas?route=photo&id=$1"
    },
    {
      "source": "/admin/atletas-filtros-:state",
      "destination": "/admin/atletas?state=:state"
    }
  ]
}
