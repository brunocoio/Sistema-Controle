Options -MultiViews
RewriteEngine On

# URLs amigáveis equivalentes para o Apache/XAMPP local.
RewriteRule ^login$ login.php [QSA,L]
RewriteRule ^logout$ logout.php [QSA,L]
RewriteRule ^admin/index$ admin/index.php [QSA,L]
RewriteRule ^admin/usuarios$ admin/usuarios.php [QSA,L]
RewriteRule ^admin/meu-perfil$ admin/meu-perfil.php [QSA,L]
RewriteRule ^admin/usuarios-novo$ admin/usuarios.php?novo=1 [QSA,L]
RewriteRule ^admin/usuario-([1-9][0-9]*)-editar$ admin/usuarios.php?id=$1 [QSA,L]
RewriteRule ^admin/usuario-atleta-([1-9][0-9]*)-novo$ admin/usuarios.php?atleta_id=$1 [QSA,L]
RewriteRule ^admin/usuario-atleta-([a-f0-9]{32})$ admin/usuarios.php?link_token=$1 [QSA,L]
RewriteRule ^admin/atletas$ admin/atletas.php [QSA,L]
RewriteRule ^admin/atletas-novo$ admin/atletas.php?route=new [QSA,L]
RewriteRule ^admin/atletas-categorias$ admin/atletas.php?route=categories [QSA,L]
RewriteRule ^admin/editar-([a-f0-9]{32})$ admin/atletas.php?route=edit&token=$1 [QSA,L]
RewriteRule ^admin/atleta-([1-9][0-9]*)-editar$ admin/atletas.php?route=edit&id=$1 [QSA,L]
RewriteRule ^admin/atleta-([1-9][0-9]*)-foto-v([a-f0-9]{32})\.img$ admin/atletas.php?route=photo&id=$1&v=$2 [QSA,L]
RewriteRule ^admin/atleta-([1-9][0-9]*)-foto-v([a-f0-9]{32})\.jpg$ admin/atletas.php?route=photo&id=$1&v=$2 [QSA,L]
RewriteRule ^admin/atleta-([1-9][0-9]*)-foto-v([a-f0-9]{32})$ admin/atletas.php?route=photo&id=$1&v=$2 [QSA,L]
RewriteRule ^admin/atleta-([1-9][0-9]*)-foto$ admin/atletas.php?route=photo&id=$1 [QSA,L]
RewriteRule ^admin/atletas-filtros-([A-Za-z0-9_-]+)$ admin/atletas.php?state=$1 [QSA,L]
RewriteRule ^admin/eventos$ admin/eventos.php [QSA,L]
RewriteRule ^admin/eventos-novo$ admin/eventos-novo.php [QSA,L]
RewriteRule ^admin/evento-([1-9][0-9]*)-editar$ admin/eventos.php?route=edit&id=$1 [QSA,L]
RewriteRule ^eventos$ eventos.php [QSA,L]
